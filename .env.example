# Brevo transactional email — create a key at https://app.brevo.com/settings/keys/api
BREVO_API_KEY=xkeysib-xxxxxxxxxxxxxxxxxxxx
# Must be a sender you have VERIFIED in Brevo, or messages are silently dropped
CONTACT_FROM_EMAIL=noreply@yourdomain.com
CONTACT_FROM_NAME=Portfolio
CONTACT_TO_EMAIL=your.real@email.com
